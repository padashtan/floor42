<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.floor42</groupId>
        <artifactId>floor42-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>floor42-coverage</artifactId>
    <packaging>pom</packaging>
    <name>Floor42 :: Coverage (quality profile only)</name>
    <description>The JaCoCo aggregate over the domain and the server. Listed in the root pom's quality profile only.</description>

    <dependencies>
        <dependency>
            <groupId>dev.floor42</groupId>
            <artifactId>floor42-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.floor42</groupId>
            <artifactId>floor42-server</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <properties>
        <sonar.sources>.</sonar.sources>
        <sonar.tests></sonar.tests>
        <sonar.skip>true</sonar.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
