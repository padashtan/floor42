<mxCell id="c3" value="&lt;b&gt;The web app on screen (floor42-web/src/App.vue)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="514" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The top bar opens panels over the 3D office; a panel shows a list and the selected item beside it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="637" height="20" as="geometry"/></mxCell>
