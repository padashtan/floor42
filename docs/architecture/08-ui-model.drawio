<diagram id="p2" name="2 State and data flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;How the UI reads the API and the event stream&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="492" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="A missed message is not a lost fact: on every connection the store reloads its state through REST." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="637" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;components/*.vue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;read the stores, call&lt;br&gt;their commands&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;state/office.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;reactive store: missions, agents,&lt;br&gt;questions, log; reload(), command()&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Other stores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;state/context.ts, drafts.ts,&lt;br&gt;viewer.ts, ...&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;api/client.ts, request.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;fetch, same-origin cookie,&lt;br&gt;X-Floor42-Request: 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;api/eventStream.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;WebSocket, reconnect with&lt;br&gt;capped backoff&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="216" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;REST /api/*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;MissionView, TicketView, ...&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="86" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;WebSockets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;/ws/events, /ws/context&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="216" width="180" height="70" as="geometry"/></mxCell>
