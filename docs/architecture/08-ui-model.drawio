<mxCell id="c7" value="&lt;b&gt;Desk: DirectorDesk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;questions waiting: permissions,&lt;br&gt;plans, escalations&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="282" width="190" height="70" as="geometry"/></mxCell>
