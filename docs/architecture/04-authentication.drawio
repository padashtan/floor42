<diagram id="p2" name="2 Director sign-in"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="592" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Two ways in for the director&amp;#x27;s browser&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="419" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The console link always works (in IAM mode it is the break-glass way); Keycloak sign-in in IAM mode." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="650" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Console link&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=40;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="610" height="172" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Keycloak sign-in (IAM mode)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=40;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="610" height="172" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;POST /auth/open&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;DirectorSignIn: single-use link,&lt;br&gt;60 s, opened or printed on stdout&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="152" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;GET /auth?...&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;LocalAccessGuard.login; IAM mode:&lt;br&gt;journaled as BreakGlassSignIn&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="152" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;GET /auth/keycloak&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;KeycloakSignIn: Authorization Code,&lt;br&gt;PKCE S256, nonce, client floor42-desk&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="392" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;GET /auth/callback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IdTokenCheck: RS256, issuer keys,&lt;br&gt;audience, nonce, 30 s skew&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="392" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;SessionRegistry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;cookie floor42_session; 8 h idle,&lt;br&gt;24 h at most; memory only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="141" width="200" height="70" as="geometry"/></mxCell>
