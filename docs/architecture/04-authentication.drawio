<mxfile host="floor42-tools-diagrams" type="device">
<diagram id="p1" name="1 Access guard"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1170" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;LocalAccessGuard: the checks before every route&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="514" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Transport checks apply to every request; credential checks to /api/* and /ws/* only." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="549" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Any request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;browser, script or agent&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Transport checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Host 127.0.0.1, localhost or [::1]; no&lt;br&gt;X-Forwarded-*; Origin is the daemon&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Path check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;no ; and no encoded / or \&lt;br&gt;in the path&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Open routes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;/api/status and /auth/*:&lt;br&gt;transport checks only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="86" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Director credential&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;cookie floor42_session, or Bearer:&lt;br&gt;script token or director&amp;#x27;s token&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="216" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Cookie and a change&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Origin and X-Floor42-Request: 1;&lt;br&gt;a WebSocket names its Origin&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="216" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;a script token: read, missions:write&lt;br&gt;or all; /ws/terminal needs all&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="346" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;The route&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;api/*Resource, /ws/*&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="346" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Agent token on /api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;403: it opens /hooks and&lt;br&gt;/mcp only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="216" width="230" height="70" as="geometry"/></mxCell>
