<diagram id="p6" name="6 Every agent call"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;The four checks on every hook and MCP call (IAM mode)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="576" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="AgentAuth.check, then IamSessions.authenticate; no network call on this path." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="505" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;1. Local verification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;AgentTokenVerifier, cached Jwks: RS256,&lt;br&gt;issuer, aud, exp + 30 s, act, floor42&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;2. Floor42&amp;#x27;s record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the live session of that launch:&lt;br&gt;jti, azp, mission, ticket&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="86" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;3. Revocation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;inactive launch, revoked agent or&lt;br&gt;delegation; failed background checks&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;4. Process&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SocketOwners: the socket owner PID&lt;br&gt;must be the launched PID&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="86" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Accepted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;to MissionGovernor.decide&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="86" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;MALFORMED, ISSUER_UNKNOWN,&lt;br&gt;BAD_SIGNATURE, EXPIRED&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SESSION_ENDED, WRONG_AUDIENCE,&lt;br&gt;WRONG_AGENT, WRONG_MISSION, WRONG_TICKET&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="216" width="300" height="70" as="geometry"/></mxCell>
