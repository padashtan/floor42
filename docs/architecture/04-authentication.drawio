<diagram id="p3" name="3 Script tokens"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Script tokens and the director&amp;#x27;s token&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="419" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Credentials for scripts: shown once, scoped, kept in memory; the journal keeps only a hash." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="593" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;POST /api/auth/tokens&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;issued from the desk, shown once&lt;br&gt;(System &amp;gt; Sessions and tokens)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;SessionRegistry: script token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;scope read, missions:write or all;&lt;br&gt;30 days at most, gone at restart&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;ApiTokenIssued&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the journal keeps&lt;br&gt;the SHA-256 only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="86" width="130" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Director&amp;#x27;s token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SessionToken: random at each&lt;br&gt;start, memory only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="216" width="230" height="70" as="geometry"/></mxCell>
