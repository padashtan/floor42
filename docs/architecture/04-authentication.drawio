<diagram id="p4" name="4 Plan approval step-up"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="741" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;The password step-up at plan approval (IAM mode)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="524" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="A script token or a break-glass session cannot approve a plan in IAM mode: no director token to delegate." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="682" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;POST .../approve&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;PlanApprovals.stepUp: a script token&lt;br&gt;or break-glass session is refused&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;StepUpApprovals.record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;202 Accepted; pending 5 min, single&lt;br&gt;use, bound to session and director&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;GET /auth/keycloak/approve&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;prompt=login, max_age=0,&lt;br&gt;openid offline_access, PKCE&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="216" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;StepUpApprovals.callback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;auth_time at or after the redirect;&lt;br&gt;Delegations.grant, then approve&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="220" height="70" as="geometry"/></mxCell>
