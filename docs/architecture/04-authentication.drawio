<diagram id="p5" name="5 Agent token minting"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="486" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;How a session gets its identity before the process starts (IAM mode)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="734" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="SessionIdentity.mint; any failure is IdentityUnavailableException and the session does not start." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="631" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Preconditions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IamStatus.blocksSessions, revoked&lt;br&gt;agent, Delegations.blocks&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Subject token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;work, retro: Delegations.subjectTokenFor;&lt;br&gt;planning: Delegations.forPlanning&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="86" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;KeycloakClient.exchange&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;by floor42-agent-&amp;lt;id&amp;gt; (vault secret),&lt;br&gt;audience floor42-api, floor42_* claims&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Keycloak mappers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ActorClaimMapper: act;&lt;br&gt;Floor42ContextMapper: floor42&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="86" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Session token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;sub director, act agent, aud floor42-api,&lt;br&gt;floor42 {launch, mission, ticket}&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="216" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;AgentTokenVerifier.verify&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Floor42 never hands out a&lt;br&gt;token it would refuse&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="216" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;AgentTokenIssued&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;journaled: jti, issuer,&lt;br&gt;expiresAt; never the token&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="216" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;HookRegistry.bindProcess&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;FLOOR42_HOOK_TOKEN in the env;&lt;br&gt;the PID kept in memory&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IAM mode off: HookRegistry mints a random token per session,&lt;br&gt;dropped when the session ends; no Keycloak.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#aaaaaa;fontSize=12;align=left;spacingLeft=8;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="350" height="50" as="geometry"/></mxCell>
