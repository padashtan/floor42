<diagram id="p1" name="1 Write path"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="910" pageHeight="746" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;One command, one writer, one journal&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="398" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Every change goes through OfficeService.execute; the journal row is written before anyone hears of it." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="663" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Who sends a command&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=40;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="280" height="570" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Director&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;a REST resource, e.g.&lt;br&gt;MissionsResource&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="148" width="200" height="70" as="geometry"/></mxCell>
