<mxCell id="c4" value="OfficeService.publish runs after the append; the browser never reads the journal itself." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="574" height="20" as="geometry"/></mxCell>
