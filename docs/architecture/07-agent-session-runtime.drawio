<diagram id="p4" name="4 Fail-closed paths"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1070" pageHeight="466" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;When something is missing or goes wrong, the session stops or is refused&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="776" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Twelve paths; none of them falls back to allowing the call." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="392" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;No sandbox, real mission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SessionTally.startRefusal: the session&lt;br&gt;fails before any process (ADR-0063)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;No identity (IAM mode)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IdentityUnavailableException in&lt;br&gt;SessionIdentity.mint: no session&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Hook unreachable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;settings.json onFailure block:&lt;br&gt;Claude Code does not run the tool&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="86" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Token refused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;401 TOKEN_REFUSED with the reason;&lt;br&gt;the hook blocks the call&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Director too slow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;awaitDecision returns PENDING:&lt;br&gt;the hook answers deny&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Tool ran unauthorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IncidentRaised (CRITICAL)&lt;br&gt;and MissionSuspended&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="196" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;call_resource, no hook&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;governor.authorized(toolUseId)&lt;br&gt;false: NOT_AUTHORIZED&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="196" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Reviewer shell unwrapped&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SessionTally.updatedInput throws:&lt;br&gt;never handed back unwrapped&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="196" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Session silent too long&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SessionProcesses.watch stops&lt;br&gt;the whole process tree&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Cost cap reached&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Claude Code&amp;#x27;s own --max-budget-usd&lt;br&gt;stops the session (ADR-0025)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="306" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Daemon restarted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ClaudeCodeRuntime.stopLeftovers&lt;br&gt;stops the last daemon&amp;#x27;s processes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="306" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Journal write fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;JournalException: the Company is&lt;br&gt;rebuilt from what is stored&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="306" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c17" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="c18" value="check that can refuse" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="412" width="119" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
