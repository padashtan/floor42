<mxCell id="c18" value="Floor42 code" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="200" y="322" width="72" height="20" as="geometry"/></mxCell>
