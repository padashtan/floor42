<diagram id="p3" name="3 What Floor42 records"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;What the session did is recorded by Floor42, never by the agent&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="682" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The process&amp;#x27;s stdout is parsed into runtime events, then journaled (Origin REAL for a live session)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="650" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Claude Code stdout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;stream-json lines&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;StreamJsonParser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ToolCompleted, AgentText,&lt;br&gt;SessionEnded, PlanUsageReported&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="86" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;SessionStream&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;governor.observed: the result&lt;br&gt;of each authorized call&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="86" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Journaled events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;AgentSessionStarted, ActionExecuted,&lt;br&gt;ActionFailed, AgentRemarked, ...&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;SecretMasker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;parsed stream lines masked&lt;br&gt;with one pattern set&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="216" width="200" height="70" as="geometry"/></mxCell>
