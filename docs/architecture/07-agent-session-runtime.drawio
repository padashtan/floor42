<mxfile host="floor42-tools-diagrams" type="device">
<diagram id="p1" name="1 Starting a session"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;From the dispatcher to a running Claude Code process&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="566" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The brief comes from the journal, never from a chat; the process gets its hook and MCP config from files." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="682" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;one ticket per developer; reviews to&lt;br&gt;a free reviewer who did not produce it&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;TaskRunner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ProduceRunner, ReviewRunner,&lt;br&gt;PlanRunner, CommitteeRunner, ...&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="86" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Briefs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;from the journal at launch: objective,&lt;br&gt;criteria, permissions, decisions&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;SessionGate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the mission&amp;#x27;s holds first; then&lt;br&gt;the session runs under MissionGovernor&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;ClaudeCodeRuntime.run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;refuses without the sandbox; IAM:&lt;br&gt;identity minted first&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="216" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;claude -p&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;--restricted --strict-mcp-config&lt;br&gt;--max-budget-usd; brief on stdin&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="216" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;settings.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;PreToolUse hook: matcher *, type http,&lt;br&gt;/hooks/pre-tool-use, onFailure block&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="346" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;mcp.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;mcpServers.floor42: http /mcp,&lt;br&gt;Bearer ${FLOOR42_HOOK_TOKEN}&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="346" width="230" height="70" as="geometry"/></mxCell>
