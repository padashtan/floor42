<diagram id="p2" name="2 One tool call"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="612" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Every tool call goes through the PreToolUse hook&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="524" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="api/HookResource, app/MissionGovernor and the domain&amp;#x27;s ActionLog decide; Claude Code runs only what is allowed." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="719" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;What the authorized call does&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=40;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="940" height="172" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;a tool call&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;AgentAuth.check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the session&amp;#x27;s token&lt;br&gt;(IAM mode: four checks)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="86" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;MissionGovernor.violation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Confinement: file tools in the worktree;&lt;br&gt;ShellGuard: no data folder, push, gh&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="86" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;ActionLog.decide&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ActionRequested; mission not active&lt;br&gt;or not on the ticket: ActionDenied&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;PermissionPolicy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ALLOW, ASK (once), ASK_ALWAYS,&lt;br&gt;DENY; Floor42 tools: authorized&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="216" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Waiting for the director&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;QuestionAsked; up to the hook&lt;br&gt;timeout minus 15 s, then deny&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="216" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;File tools&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Read, Edit, Write, Glob, Grep&lt;br&gt;in the worktree&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="412" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Bash in the sandbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;SessionTally.updatedInput:&lt;br&gt;Sandbox.wrapForShell&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d4ecec;strokeColor=#3d8c8c;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="412" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Floor42 MCP tools&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ask_director,&lt;br&gt;call_resource (broker)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="412" width="150" height="70" as="geometry"/></mxCell>
