<mxCell id="c4" value="Routes from floor42-web/src/api/openapi.json, read when the diagrams are built; LocalAccessGuard decides." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="682" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Director&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;cookie floor42_session,&lt;br&gt;or a script token (Bearer)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Agent session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;its own token (Bearer)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Anyone on the machine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;no credential&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;LocalAccessGuard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;transport checks on every route;&lt;br&gt;/api and /ws need a director credential&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Director routes /api/* (180)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;24 tags; scopes on the next pages:&lt;br&gt;[r] read, [w] missions:write, [a] all&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;WebSockets /ws/*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;/ws/events, /ws/context, /ws/api-calls;&lt;br&gt;/ws/terminal/{id}: scope all + ticket&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="216" width="230" height="70" as="geometry"/></mxCell>
