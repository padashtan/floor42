<diagram id="p6" name="6 Revocation"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Revocation as a timeline: when each path stops an agent&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="598" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Bounds measured by RevocationGuaranteesTest against FakeKeycloak (docs/iam-revocation.md), not a real Keycloak." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="722" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Next call (0 passes)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="73" y="88" width="152" height="26" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Next pass (60 s + the pass)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="321" y="88" width="197" height="26" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Second failed pass (about 2 min)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="585" y="88" width="229" height="26" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;300 s&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="915" y="88" width="90" height="26" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;exp + 30 s (at most 8 h)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1116" y="88" width="178" height="26" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;1a Delegation revoked&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;in the UI, or the mission ends:&lt;br&gt;next hook REVOKED, session stopped&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;2a Agent revoked, dismissed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;AgentClients.revokeLocally:&lt;br&gt;hooks and broker, 0 passes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Broker after a revoke&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IDENTITY_REFUSED on the next&lt;br&gt;call_resource, even Keycloak down&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;2b Client disabled at Keycloak&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;hooks: introspection active:false;&lt;br&gt;broker: refused at once&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="146" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;3a Token inactive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;active:false at Keycloak:&lt;br&gt;that launch refused for good&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="246" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Silent session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;stopRevoked(), first step of&lt;br&gt;a pass: no call needed&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="346" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;4 Keycloak unreachable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;pass 1: no new session; pass 2:&lt;br&gt;running ones KEYCLOAK_UNREACHABLE&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="146" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;6 floor42-api refused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;IAM_API_CREDENTIAL_REFUSED;&lt;br&gt;same limit as case 4&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="246" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;5 Broker token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;at the resource until it expires,&lt;br&gt;unless the resource introspects&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="146" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;3b Expiry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;local check, no network;&lt;br&gt;exp - iat over 8 h + 30 s refused&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="146" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;2c Secret rotated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;revokes nothing: hooks run to exp;&lt;br&gt;disable the client instead&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="246" width="210" height="70" as="geometry"/></mxCell>
