<diagram id="p2" name="2 Token chain"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;From the director&amp;#x27;s approval to one allowed or refused tool call&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="692" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Each step can stop the chain; a refusal is journaled. Read left to right, then right to left." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="606" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;1. Plan approval&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;StepUpApprovals: prompt=login,&lt;br&gt;max_age=0, the password again&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;2. Mission delegation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Delegations.grant: offline token in the&lt;br&gt;vault; refreshed via floor42-desk&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="86" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;3. Token exchange, RFC 8693&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;KeycloakClient.exchange by floor42-agent-&amp;lt;id&amp;gt;,&lt;br&gt;subject = the director&amp;#x27;s access token&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="86" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;4. Session token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;sub director, act agent, aud floor42-api,&lt;br&gt;floor42 {launch, mission, ticket}, exp &amp;lt;= 8 h&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="86" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;5. Process binding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;env FLOOR42_HOOK_TOKEN; PID from&lt;br&gt;builder.start() kept in memory&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="216" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;6. PreToolUse hook checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;signature, issuer, aud, exp + 30 s; launch,&lt;br&gt;mission, ticket, revocation, socket PID&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="216" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;7. Permission table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;MissionGovernor.decide, ActionLog:&lt;br&gt;ALLOW, ASK, ASK_ALWAYS, DENY&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="216" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Allowed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;ActionAuthorized; Bash rewritten&lt;br&gt;into the WSL sandbox&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="346" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;401 TOKEN_REFUSED or ActionDenied;&lt;br&gt;journaled when attributable&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="230" height="70" as="geometry"/></mxCell>
