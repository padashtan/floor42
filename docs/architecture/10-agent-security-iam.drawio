<diagram id="p3" name="3 Resource broker"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="376" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;call_resource: the agent asks, Floor42 holds the credential and makes the call&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="839" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The agent never sees a resource credential; it gets the answer as untrusted data." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="530" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;MCP tool call_resource&lt;br&gt;(resource, method, path, body)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;PreToolUse hook&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;same checks as any tool;&lt;br&gt;ActionAuthorized for the toolUseId&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="86" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;McpResource&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;governor.authorized(toolUseId):&lt;br&gt;one broker call per authorization&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="86" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;ResourceBroker.call&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the caller&amp;#x27;s verified claims,&lt;br&gt;never a token from the agent&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="86" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;ResourceCatalogue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;both grants: the agent&amp;#x27;s and the mission&amp;#x27;s;&lt;br&gt;method and path prefix allowed&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="86" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Second token exchange&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;audience = exactly the resource;&lt;br&gt;at most 300 s, checked after issue&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="216" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;SafeUrls, PinnedClients&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;resolve once, refuse private ranges, pin&lt;br&gt;the IP; SNI checked, no redirect&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="216" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;External resource&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;HTTPS API from iam/resources.json&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="216" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Answer to the agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;token scrubbed, body capped, quoted&lt;br&gt;between BEGIN-UNTRUSTED-&amp;lt;nonce&amp;gt; lines&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="250" height="70" as="geometry"/></mxCell>
