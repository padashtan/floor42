<diagram id="p5" name="5 Attacks"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="930" pageHeight="646" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;What an attacker gets at each boundary, what stops it, what remains&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="724" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Four attacks from docs/threat-model.md section 3; residual risk is what is left with the control on." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="650" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;What the attacker has&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="88" width="159" height="26" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;What stops it&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="401" y="88" width="107" height="26" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;What remains&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="714" y="88" width="101" height="26" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Prompt injection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;boundary (2): the agent obeys text&lt;br&gt;from a file or a resource answer&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Bounded by the code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;permission table, fail-closed hook,&lt;br&gt;own worktree, sandbox; answers wrapped&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="156" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Residual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;within what the table allows it acts,&lt;br&gt;with its real identity&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="156" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Session token stolen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;boundary (2): a copy of the&lt;br&gt;token outside Floor42&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Token checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;RS256, issuer, aud floor42-api, exp &amp;lt;= 8 h,&lt;br&gt;a live session; ending it refuses the token&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="266" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Residual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;expiry is not revocation; a copy inside&lt;br&gt;the owning process is accepted&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="266" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Token used by another process&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;boundary (2): curl from the&lt;br&gt;agent&amp;#x27;s shell with the token&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Process binding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;socket owner PID must be the PID&lt;br&gt;Floor42 launched: WRONG_PROCESS&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="376" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Residual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;owner resolved per request; only the native&lt;br&gt;claude install measured; none outside IAM&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="376" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;Agent shell compromised&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;boundary (3): code runs&lt;br&gt;in the agent&amp;#x27;s sandbox&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;WSL sandbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;journal, vault, settings, other worktrees&lt;br&gt;not mounted; network cut by default&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="486" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Residual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;kernel escape out of scope; unsafe mode&lt;br&gt;or Docker: the shell can write the journal&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="486" width="250" height="70" as="geometry"/></mxCell>
