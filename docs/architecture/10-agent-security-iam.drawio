<diagram id="p4" name="4 Trust boundaries"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="566" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;The five boundaries an attack has to cross, and what guards each&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="692" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="From docs/threat-model.md section 2. The daemon is orchestrator and security authority in one process." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="663" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Floor42 daemon, one process on 127.0.0.1&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=40;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="550" y="86" width="510" height="280" as="geometry"/></mxCell>
