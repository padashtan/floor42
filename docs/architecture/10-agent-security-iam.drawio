<mxfile host="floor42-tools-diagrams" type="device">
<diagram id="p1" name="1 Identities"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="852" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Who is who, and where each secret lives (IAM mode)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="545" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="Every identity in the realm, what holds its secret, and the one token an agent process ever sees." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="631" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;Keycloak, realm floor42&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;opacity=40;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="850" height="432" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Data folder, iam/ (never mounted in the sandbox)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;opacity=40;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="950" y="155" width="360" height="302" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;Daemon memory only&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=40;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="850" height="172" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;Director&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Keycloak user; signs in through&lt;br&gt;floor42-desk (browser, PKCE S256)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="215" y="152" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;floor42-desk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;public client: the director&amp;#x27;s sign-in&lt;br&gt;and the refresh of a delegation&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="485" y="152" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;floor42-agent-&amp;lt;id&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;one confidential client per agent;&lt;br&gt;it performs the token exchange&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="215" y="282" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;floor42-api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;audience of every agent session token;&lt;br&gt;Floor42 introspects with its secret&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="485" y="282" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;floor42-daemon&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;service account, manage-clients:&lt;br&gt;creates and disables agent clients&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="485" y="412" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;SecretVault&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;AES-256-GCM, key file iam/vault.key; entries:&lt;br&gt;floor42-api, floor42-daemon, agent-&amp;lt;id&amp;gt; secrets&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="217" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;delegation-&amp;lt;mission&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;offline refresh token of the director, 30 days;&lt;br&gt;delegations.json keeps metadata only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fde9f3;strokeColor=#b5487f;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="347" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;SessionRegistry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;browser session: cookie floor42_session,&lt;br&gt;HttpOnly, SameSite=Strict, SHA-256 kept&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="652" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;DirectorTokens&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;the director&amp;#x27;s Keycloak tokens&lt;br&gt;after sign-in, never shown&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="652" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;IamSessions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;live session record: launch, mission,&lt;br&gt;ticket, jti, bound PID&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="652" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Claude Code process&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;holds only its session token,&lt;br&gt;env FLOOR42_HOOK_TOKEN&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="641" width="360" height="70" as="geometry"/></mxCell>
