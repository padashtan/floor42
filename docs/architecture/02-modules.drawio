<diagram id="p1" name="1 Maven modules"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="612" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="&lt;b&gt;Three modules: a pure domain, the Quarkus daemon, the web app&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="660" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="The domain knows only the JDK; the web app talks to the daemon over HTTP and WebSocket only." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="602" height="20" as="geometry"/></mxCell>
