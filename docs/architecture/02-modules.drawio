<mxCell id="c4" value="ArchUnit rules of floor42-server/.../ArchitectureTest.java, and one Vitest rule for the web app." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="625" height="20" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;domainDependsOnJdkOnly&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;dev.floor42.domain.. depends only on&lt;br&gt;dev.floor42.domain.. and java..&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;runtimesDoNotReachIntoTheApplication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;runtime.. may not depend on&lt;br&gt;app.., api.., journal..&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="86" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;iamDoesNotReachIntoTheApplication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;iam.. may not depend on app.., api..,&lt;br&gt;journal..; it asks through OfficeFacts&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="86" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;journalIsLowLevel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;journal.. may not depend on&lt;br&gt;app.., api.., runtime..&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;apiIsALeaf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;nothing outside api..&lt;br&gt;depends on api..&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="216" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;securityIsIndependent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;security.. may not depend on&lt;br&gt;domain.., app.., journal..&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="216" width="270" height="70" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;domainClassesDoNotExtendDomainClasses&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;composition, not inheritance:&lt;br&gt;DOMAIN_SUBCLASSES_ALLOWED is empty&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;threadsStartOnlyInTheScheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;threads start in app.MissionScheduler&lt;br&gt;and the classes of THREADS_ALLOWED&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="346" width="290" height="70" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;scene/boundaries.test.ts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444444;&quot;&gt;Vitest: floor42-web/src/scene imports&lt;br&gt;no vue, pinia, ../ui, ../components&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="346" width="270" height="70" as="geometry"/></mxCell>
