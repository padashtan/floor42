  "f1738081643065fe21e21ed56cc3b891_0": {
    "author": "q8c",
    "comment": "Jwts.parse only decodes. This site reads a token Floor42 got itself from Keycloak (or one already checked by AgentTokenVerifier/IdTokenCheck.verify, signature, alg, audience, expiry) and takes no trust decision from it; the verifying paths are AgentTokenVerifier.verify and IdTokenCheck.claims",
    "false_positive": true,
    "ignored_at": "2026-11-09T00:00:00Z"
  },
